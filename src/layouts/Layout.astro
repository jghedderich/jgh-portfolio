---
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/common/Footer.astro';
import { localeOgTags, type Locale } from '../i18n/ui';
import { getAlternateUrls, getLangFromUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/translate';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = t('meta.title'), description = t('meta.description') } =
  Astro.props;

const site = Astro.site?.href ?? 'https://juanhedderich.com';
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const alternates = getAlternateUrls(Astro.url.pathname, site);

import '@fontsource-variable/inter';
import '../styles/global.css';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {
      alternates.map(({ locale, href }) => (
        <link rel="alternate" hreflang={locale} href={href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={alternates.find((a) => a.locale === 'en')?.href ?? canonicalUrl}
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeOgTags[lang]} />
    {
      alternates
        .filter(({ locale }) => locale !== lang)
        .map(({ locale }) => (
          <meta
            property="og:locale:alternate"
            content={localeOgTags[locale as Locale]}
          />
        ))
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL('og.jpg', site).href}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <ClientRouter />
  </head>
  <body>
    <div class="relative h-full w-full bg-white">
      <div
        class="fixed inset-0 -z-10 h-full w-full bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px]"
      >
      </div>
    </div>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  html {
    font-family: 'Inter Variable', sans-serif;
    color-scheme: light;
    scrollbar-gutter: stable;
  }
</style>
