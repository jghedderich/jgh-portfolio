---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Página no encontrada" description="Página no encontrada">
  <section class="py-60 flex flex-col justify-center items-center gap-6">
    <h1 class="text-7xl font-bold">404</h1>
    <h2 class="text-3xl font-bold">Página no encontrada</h2>
    <a href="/" class="text-blue-600 hover:underline"
      >Ir a la página principal</a
    >
  </section>
</Layout>
