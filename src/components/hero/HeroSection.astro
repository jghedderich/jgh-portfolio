---
import GithubIcon from '../icons/github-mark.astro';
import DownloadDocumentIcon from '../icons/downloadDocument.astro';
import { Image } from 'astro:assets';
import juanImage from '../../assets/juan-photo.jpg';

const today = new Date();
const firstJune2023 = new Date('2023-06-01');

const yearsPassed = Math.floor(
  (today.getTime() - firstJune2023.getTime()) / (1000 * 60 * 60 * 24 * 365)
);
const yearsText = `${yearsPassed} ${yearsPassed === 1 ? 'year' : 'years'} of experience`;
---

<section
  class="flex flex-col-reverse md:flex-row max-w-screen-lg gap-10 items-center px-5 my-24 mx-auto"
>
  <div class="flex flex-col items-start gap-2">
    <h1 class="text-3xl md:text-7xl font-semibold leading-tight text-balance">
      {'Hi, I’m '}
      <span class="text-blue-600">Juan</span>
    </h1>
    <p
      class="text-base md:text-xl text-balance mt-2 text-gray-700 dark:text-gray-300"
    >
      Software engineer with <span>{yearsText}</span>. I focus on
      React and AI (RAG). EU citizen. Currently at Inmobiliaria Terepaima 🏠.
    </p>
    <div class="flex gap-3 mt-5">
      <a
        href="https://github.com/jghedderich"
        target="_blank"
        class="shadow hover:bg-blue-500 bg-blue-600 rounded-full text-white transition ease-out gap-3 px-4 flex items-center will-change-transform font-bold min-w-max"
      >
        GitHub
        <GithubIcon class="size-6" />
      </a>
      <a
        href="/JGH-CV.pdf"
        download="Juan-Hedderich-CV.pdf"
        class="shadow hover:bg-blue-500 bg-blue-600 rounded-full text-white transition ease-out flex gap-3 items-center h-fit px-4 py-2 will-change-transform font-bold min-w-max"
      >
        Download CV
        <DownloadDocumentIcon class="size-6" />
      </a>
    </div>
  </div>
  <Image
    src={juanImage}
    loading="eager"
    alt=""
    class="rounded-full size-52 md:size-72 shadow-md border dark:border-none"
  />
</section>
