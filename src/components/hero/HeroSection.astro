---
import Icon from "../icons/Icon.astro";
import { Image } from "astro:assets";
import juanImage from "../../assets/juan-photo.jpg";
import { getLangFromUrl } from "../../i18n/utils";
import { useTranslations } from "../../i18n/translate";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const today = new Date();
const firstJune2023 = new Date("2023-06-01");

const yearsPassed = Math.round(
  (today.getTime() - firstJune2023.getTime()) / (1000 * 60 * 60 * 24 * 365),
);
const yearLabel =
  yearsPassed === 1 ? t("hero.yearSingular") : t("hero.yearPlural");
const yearsText = `${yearsPassed} ${yearLabel}`;
const bio = t("hero.bio").replace("{years}", yearsText);

const buttonClass =
  "shadow hover:bg-blue-500 bg-blue-600 rounded-full text-white text-sm transition ease-out gap-2 px-3 py-1.5 flex items-center will-change-transform font-semibold min-w-max";
---

<section
  class="flex flex-col-reverse md:flex-row max-w-screen-md gap-10 items-center px-5 my-24 mx-auto"
>
  <div class="flex flex-col items-start gap-2">
    <h1 class="text-3xl md:text-5xl font-semibold leading-tight text-balance">
      {t("hero.greeting")}
      <span class="text-blue-600">Juan</span>
    </h1>
    <p class="text-base text-balance mt-2 text-black dark:text-gray-300">
      {bio}
    </p>
    <div class="flex flex-wrap gap-3 mt-3">
      <a
        href="https://github.com/jghedderich"
        target="_blank"
        rel="noopener noreferrer"
        class={buttonClass}
      >
        GitHub
        <Icon name="github-mark" class="size-5" />
      </a>
      <a
        href="https://www.linkedin.com/in/juan-hedderich-00778825b/"
        target="_blank"
        rel="noopener noreferrer"
        class={buttonClass}
      >
        LinkedIn
        <Icon name="linkedin" class="size-5" />
      </a>
      <div class="relative" id="cv-download">
        <button
          type="button"
          id="cv-download-toggle"
          class={buttonClass}
          aria-expanded="false"
          aria-haspopup="menu"
          aria-controls="cv-download-menu"
        >
          {t("hero.downloadCv")}
          <Icon name="downloadDocument" class="size-5" />
          <Icon
            name="chevronDown"
            id="cv-chevron"
            class="size-4 transition-transform duration-200"
          />
        </button>
        <div
          id="cv-download-menu"
          role="menu"
          class="hidden absolute left-0 top-full z-10 mt-2 min-w-full overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-slate-900"
        >
          <a
            role="menuitem"
            href="/Juan_Hedderich_CV_With_Foto.pdf"
            download="Juan-Hedderich-CV-With-Photo.pdf"
            class="block px-4 py-2.5 text-sm font-semibold text-gray-900 transition ease-out hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-slate-800"
          >
            {t("hero.cvWithPhoto")}
          </a>
          <a
            role="menuitem"
            href="/JGH-CV.pdf"
            download="Juan-Hedderich-CV.pdf"
            class="block px-4 py-2.5 text-sm font-semibold text-gray-900 transition ease-out hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-slate-800"
          >
            {t("hero.cvNoPhoto")}
          </a>
        </div>
      </div>
    </div>
    <p class="text-sm mt-3">{t("hero.languages")}</p>
  </div>
  <div class="shrink-0">
    <Image
      src={juanImage}
      loading="eager"
      alt=""
      class="rounded-full size-40 md:size-56 shadow-md border border-gray-200 dark:border-none"
    />
  </div>
</section>

<script>
  const container = document.getElementById("cv-download");
  const toggle = document.getElementById("cv-download-toggle");
  const menu = document.getElementById("cv-download-menu");
  const chevron = document.getElementById("cv-chevron");

  function setOpen(open: boolean) {
    toggle?.setAttribute("aria-expanded", String(open));
    menu?.classList.toggle("hidden", !open);
    chevron?.classList.toggle("rotate-180", open);
  }

  function isOpen() {
    return toggle?.getAttribute("aria-expanded") === "true";
  }

  toggle?.addEventListener("click", () => {
    setOpen(!isOpen());
  });

  document.addEventListener("click", (event) => {
    if (!isOpen()) return;
    const target = event.target as Node;
    if (!container?.contains(target)) {
      setOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
</script>
