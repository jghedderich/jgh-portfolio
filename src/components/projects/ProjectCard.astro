---
import { Image } from 'astro:assets';
import type { Project } from '../../types/project';
import Badge from '../common/Badge.astro';
import Arrow from '../icons/arrow.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="border dark:border-none rounded-md shadow hover:shadow-lg transition ease-out overflow-hidden bg-white dark:bg-slate-800 dark:hover:bg-slate-700 group duration-500"
>
  <a href={'/projects/' + project.slug} class="flex flex-col">
    <div
      class="bg-blue-50 transition ease-out duration-500 dark:bg-slate-900 dark:group-hover:bg-slate-800 group"
    >
      <Image
        src={project.thumbnail}
        alt={project.name}
        loading="eager"
        class="h-64 object-cover w-full"
      />
    </div>
    <section class="p-4 min-w-full border-t dark:border-none">
      <div class="flex items-center gap-2">
        <h4 class="w-fit text-2xl font-semibold">{project.name}</h4>
        <Arrow
          class="size-4 -rotate-90 group-hover:translate-x-1 transition ease-out text-blue-500"
          stroke-width="3"
        />
      </div>
      <p class="text-gray-700 dark:text-gray-300 mb-3">{project.description}</p>

      <div class="flex gap-3">
        {
          project.technologies.frontend.map((tech) => (
            <Badge label={tech.name} />
          ))
        }
        {
          project.technologies.backend.map((tech) => (
            <Badge label={tech.name} />
          ))
        }
      </div>
    </section>
  </a>

  <style>
    .mask {
      mask-image: linear-gradient(white, transparent);
    }
  </style>
</article>
