---
import { Image } from 'astro:assets';
import type { Skill } from '../../types/skill';

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
---

<a
  href={skill.url}
  target="_blank"
  class="flex flex-col group items-center p-3 transition ease-out bg-slate-50 hover:bg-slate-100 rounded-lg"
>
  <Image
    src={skill.image}
    loading="lazy"
    alt=`${skill.name} icon`
    class="w-full h-12 md:h-14 group-hover:scale-105 group-hover:rotate-3 transition ease-out"
  />

  <p class="text-center text-sm mt-2">
    {skill.name}
  </p>
</a>
