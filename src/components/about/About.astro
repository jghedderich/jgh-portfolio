---
import { Image } from 'astro:assets';
import juanImage from '../../assets/juan-restaurante.jpeg';
import Icon from '../icons/Icon.astro';
---

<section class="p-6 mt-6 max-w-screen-lg mx-auto w-full">
  <div class="flex gap-3 items-center mb-6">
    <Icon name="user" class="size-9" />
    <h2 class="text-3xl font-semibold">About me</h2>
  </div>
  <div
    class="flex justify-between md:flex-row flex-col-reverse items-center gap-10"
  >
    <div class="text-gray-700 dark:text-gray-300">
      <p class="mb-2 max-w-lg">
        My name is Juan Guillermo Hedderich. I started programming at 17, shortly
        before university. I&apos;m studying computer engineering at Universidad
        Católica Andrés Bello (UCAB).
      </p>
      <p class="max-w-lg">
        I&apos;ve taken several courses in frontend development and UX. I enjoy
        expressing my interest in art and design through the applications I build.
        I also like music, sports, and video games.
      </p>
      <div class="flex items-center gap-5 mt-5 text-black">
        <a
          href="https://github.com/jghedderich"
          target="_blank"
          aria-label="Juan Hedderich GitHub profile link"
          class="hover:scale-105 hover:rotate-6 transition ease-out"
        >
          <Icon name="github-mark" class="size-10 dark:text-white" />
        </a>
        <a
          href="https://www.linkedin.com/in/juan-hedderich-00778825b/"
          target="_blank"
          aria-label="Juan Hedderich LinkedIn profile link"
          class="hover:scale-105 hover:rotate-6 transition ease-out"
        >
          <Icon name="linkedin" class="size-10 dark:text-white" />
        </a>
        <a
          href="mailto:hedderich.dev@gmail.com"
          target="_blank"
          aria-label="email link"
          class="hover:scale-105 hover:-rotate-6 transition ease-out"
        >
          <Icon name="email" class="size-10 dark:text-white" />
        </a>
      </div>
    </div>
    <Image
      src={juanImage}
      loading="lazy"
      alt="Juan Hedderich"
      class="rounded-lg p-1 bg-gray-200 w-52 md:w-72 h-full rotate-3 shadow-md"
    />
  </div>
</section>
