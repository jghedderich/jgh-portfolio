---
import { Image } from 'astro:assets';
import juanImage from '../../assets/juan-restaurante.jpeg';
import Icon from '../icons/Icon.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { useTranslations } from '../../i18n/translate';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="px-5 max-w-screen-md mx-auto w-full">
  <div class="flex gap-3 items-center mb-4">
    <Icon name="user" class="size-9" />
    <h2 class="text-3xl font-semibold">{t('section.about')}</h2>
  </div>
  <div
    class="flex justify-between md:flex-row flex-col items-center gap-6 md:gap-10"
  >
    <div class="text-gray-700">
      <p class="mb-2 max-w-lg">
        {t('about.p1')}
      </p>
      <p class="max-w-lg">
        {t('about.p2')}
      </p>
      <div class="flex items-center gap-5 mt-5 text-black">
        <a
          href="https://github.com/jghedderich"
          target="_blank"
          aria-label="Juan Hedderich GitHub profile link"
          class="hover:scale-105 hover:rotate-6 transition ease-out"
        >
          <Icon name="github-mark" class="size-10" />
        </a>
        <a
          href="https://www.linkedin.com/in/juanhedderich/"
          target="_blank"
          aria-label="Juan Hedderich LinkedIn profile link"
          class="hover:scale-105 hover:rotate-6 transition ease-out"
        >
          <Icon name="linkedin" class="size-10" />
        </a>
        <a
          href="mailto:hedderich.dev@gmail.com"
          target="_blank"
          aria-label="email link"
          class="hover:scale-105 hover:-rotate-6 transition ease-out"
        >
          <Icon name="email" class="size-10" />
        </a>
      </div>
    </div>
    <Image
      src={juanImage}
      loading="lazy"
      alt="Juan Hedderich"
      class="rounded-lg p-1 bg-gray-200 w-52 md:w-72 h-full rotate-3 shadow-md"
    />
  </div>
</section>
