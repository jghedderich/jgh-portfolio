---
import Icon from '../components/icons/Icon.astro';
import LanguageSelector from './common/LanguageSelector.astro';
import { getLangFromUrl, stripLocaleFromPath, translatePath } from '../i18n/utils';

const currentPath = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const homeHref = translatePath('/', lang);
const isProjectPage = stripLocaleFromPath(currentPath).startsWith('/projects');
---

<nav
  class="border-b border-gray-200 bg-white flex justify-center items-center h-16 w-full z-30 transition ease-out"
  id="navbar"
>
  <div class="relative w-full max-w-screen-xl">
    {
      isProjectPage && (
        <a
          href={homeHref}
          class="flex gap-1 items-center pl-9 hover:text-blue-600 transition ease-out w-fit"
        >
          <div class="rotate-90">
            <Icon name="arrow" class="size-5" />
          </div>
        </a>
      )
    }

    <LanguageSelector />

    <a
      href={homeHref}
      aria-label="Home"
      class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"
    >
      <Icon
        name="logo"
        class="hover:scale-105 hover:-rotate-6 transition ease-out size-16"
      />
    </a>
  </div>
</nav>

<script>
  let prevScrollPosition = window.scrollY;

  function checkScrollDirection() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    const scrollPosition = window.scrollY;
    if (scrollPosition > prevScrollPosition) {
      navbar.classList.add('hide');
    } else {
      navbar.classList.remove('hide');
    }
    prevScrollPosition = scrollPosition;
  }

  function onPageLoad() {
    prevScrollPosition = window.scrollY;
    document.getElementById('navbar')?.classList.remove('hide');
  }

  // Module scripts run once; look up #navbar on each scroll so View Transitions
  // page swaps don't leave a stale element reference.
  window.addEventListener('scroll', checkScrollDirection, { passive: true });
  document.addEventListener('astro:page-load', onPageLoad);
</script>

<style>
  #navbar {
    position: fixed;
    top: 0;
    transition: transform 0.3s ease-out;
  }

  #navbar.hide {
    transform: translateY(-100%);
  }
</style>
